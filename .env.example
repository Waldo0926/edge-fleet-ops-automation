# Control-plane endpoint returning node metadata and IPv6 candidates.
EDGE_CONTROL_API=https://control.example.invalid/api/nodes

# Use key-based SSH. Do not put passwords in this file.
EDGE_SSH_USER=root
EDGE_SSH_KEY=~/.ssh/id_ed25519

EDGE_STATE_DIR=./var/state
EDGE_LOG_DIR=./var/log
EDGE_DISK_WARN_PERCENT=80
EDGE_DISK_CRITICAL_PERCENT=90
EDGE_DISK_MIN_FREE_MB=1024
